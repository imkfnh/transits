<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sky right now: current transits</title>
<meta name="description" content="Live planetary positions and aspects, calculated in your browser.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #07061a;
    --night: #121030;
    --veil: #1c1946;
    --moon: #ece8f8;
    --mist: #9a95bd;
    --gold: #e8c97a;
    --rose: #f08aa4;
    --coral: #ff9e7a;
    --aqua: #7fd1ce;
    --violet: #a99bff;
    --line: rgba(169, 155, 255, 0.18);
  }
  * { box-sizing: border-box; }
  html { color-scheme: dark; }
  body {
    margin: 0;
    min-height: 100vh;
    color: var(--moon);
    font-family: "Instrument Sans", system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.5;
    background:
      radial-gradient(ellipse at 50% -10%, #2a235f 0%, transparent 55%),
      radial-gradient(ellipse at 90% 60%, #1a1445 0%, transparent 50%),
      var(--ink);
    background-attachment: fixed;
  }
  #stars { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
  .page { position: relative; z-index: 1; max-width: 1120px; margin: 0 auto; padding: 32px 20px 64px; }

  header { margin-bottom: 28px; }
  h1 {
    margin: 0;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 500;
    font-size: clamp(2.6rem, 8vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  #when { margin: 10px 0 0; color: var(--mist); font-size: 1rem; }
  .controls { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-top: 18px; }
  .controls label { color: var(--mist); font-size: 0.9rem; }
  input[type="datetime-local"], button {
    font: inherit;
    color: var(--moon);
    background: rgba(28, 25, 70, 0.7);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 9px 12px;
  }
  button { cursor: pointer; }
  button:hover, input:hover { border-color: rgba(169, 155, 255, 0.5); }
  button:focus-visible, input:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
  #live-badge { font-size: 0.85rem; color: var(--aqua); }
  #live-badge.off { color: var(--mist); }

  .layout { display: grid; gap: 40px; grid-template-columns: 1fr; }
  @media (min-width: 860px) {
    .layout { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
  }

  .glyph { font-family: "Noto Sans Symbols 2", "Noto Sans Symbols", "Segoe UI Symbol", "Apple Symbols", sans-serif; }

  h2 {
    margin: 0 0 12px;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-weight: 500;
    font-size: 1.9rem;
  }
  ul.rows { list-style: none; margin: 0; padding: 0; }
  ul.rows li {
    display: grid;
    align-items: center;
    gap: 10px;
    padding: 10px 4px;
    border-bottom: 1px solid var(--line);
  }
  ul.planets li { grid-template-columns: 34px 82px 1fr auto; }
  ul.aspects li { grid-template-columns: 30px 1fr 30px auto; }
  .g { font-size: 1.4rem; text-align: center; }
  .pos { font-variant-numeric: tabular-nums; }
  .sign { color: var(--mist); }
  .retro { color: var(--rose); font-size: 0.85rem; }
  .asp-name { text-align: center; font-size: 0.95rem; }
  .asp-name small { display: block; color: var(--mist); font-size: 0.8rem; }
  .orb { color: var(--mist); font-size: 0.85rem; text-align: right; font-variant-numeric: tabular-nums; }
  .applying { color: var(--gold); }
  .empty { color: var(--mist); padding: 12px 4px; }

  footer { margin-top: 48px; color: var(--mist); font-size: 0.85rem; max-width: 60ch; }
  #error { display: none; padding: 16px; border: 1px solid var(--rose); border-radius: 10px; margin-bottom: 24px; }
</style>
</head>
<body>
<canvas id="stars" aria-hidden="true"></canvas>

<div class="page">
  <header>
    <h1>Sky right now</h1>
    <p id="when"></p>
    <div class="controls">
      <label for="when-input">View another moment</label>
      <input id="when-input" type="datetime-local">
      <button id="now-btn" type="button">Back to now</button>
      <span id="live-badge">Live, updates every minute</span>
    </div>
  </header>

  <div id="error" role="alert">
    The calculation library didn't load. Check your connection and reload the page.
  </div>

  <div class="layout">
    <section aria-labelledby="pl-h">
      <h2 id="pl-h">Planets</h2>
      <ul class="rows planets" id="planets"></ul>
    </section>
    <section aria-labelledby="as-h">
      <h2 id="as-h">Aspects</h2>
      <ul class="rows aspects" id="aspects"></ul>
    </section>
  </div>

  <footer>
    Tropical zodiac, geocentric positions, calculated in your browser with Astronomy Engine. Aspects use orbs of 8° for conjunctions and oppositions, 6° for squares and trines, and 4° for sextiles.
  </footer>
</div>

<script src="https://cdn.jsdelivr.net/npm/astronomy-engine@2.1.19/astronomy.browser.min.js"></script>
<script>
(function () {
  const VS = "\uFE0E"; // forces text (not emoji) rendering for symbols
  const BODIES = [
    { id: "Sun", g: "☉" }, { id: "Moon", g: "☽" }, { id: "Mercury", g: "☿" },
    { id: "Venus", g: "♀" }, { id: "Mars", g: "♂" }, { id: "Jupiter", g: "♃" },
    { id: "Saturn", g: "♄" }, { id: "Uranus", g: "♅" }, { id: "Neptune", g: "♆" },
    { id: "Pluto", g: "♇" }
  ];
  const SIGNS = [
    ["Aries", "♈"], ["Taurus", "♉"], ["Gemini", "♊"], ["Cancer", "♋"],
    ["Leo", "♌"], ["Virgo", "♍"], ["Libra", "♎"], ["Scorpio", "♏"],
    ["Sagittarius", "♐"], ["Capricorn", "♑"], ["Aquarius", "♒"], ["Pisces", "♓"]
  ];
  const ASPECTS = [
    { name: "Conjunction", angle: 0,   orb: 8, g: "☌", color: "#e8c97a" },
    { name: "Sextile",     angle: 60,  orb: 4, g: "⚹", color: "#a99bff" },
    { name: "Square",      angle: 90,  orb: 6, g: "□", color: "#f08aa4" },
    { name: "Trine",       angle: 120, orb: 6, g: "△", color: "#7fd1ce" },
    { name: "Opposition",  angle: 180, orb: 8, g: "☍", color: "#ff9e7a" }
  ];

  const norm360 = x => ((x % 360) + 360) % 360;
  const norm180 = x => { x = norm360(x); return x > 180 ? x - 360 : x; };
  const pad = n => String(n).padStart(2, "0");
  const G = s => s + VS;

  function lonAt(id, date) {
    const vec = Astronomy.GeoVector(id, date, true);
    return norm360(Astronomy.Ecliptic(vec).elon);
  }

  function computePlanets(date) {
    const DAY = 86400000;
    return BODIES.map(b => {
      const lon = lonAt(b.id, date);
      const before = lonAt(b.id, new Date(date.getTime() - DAY / 2));
      const after = lonAt(b.id, new Date(date.getTime() + DAY / 2));
      const retro = b.id !== "Sun" && b.id !== "Moon" && norm180(after - before) < 0;
      return { ...b, lon, retro };
    });
  }

  function computeAspects(planets, date) {
    const later = new Date(date.getTime() + 3 * 3600000);
    const lonsLater = {};
    BODIES.forEach(b => { lonsLater[b.id] = lonAt(b.id, later); });
    const out = [];
    for (let i = 0; i < planets.length; i++) {
      for (let j = i + 1; j < planets.length; j++) {
        const a = planets[i], b = planets[j];
        const angle = Math.abs(norm180(a.lon - b.lon));
        const angleLater = Math.abs(norm180(lonsLater[a.id] - lonsLater[b.id]));
        for (const asp of ASPECTS) {
          const orb = Math.abs(angle - asp.angle);
          if (orb <= asp.orb) {
            const orbLater = Math.abs(angleLater - asp.angle);
            out.push({ a, b, asp, orb, applying: orbLater < orb });
          }
        }
      }
    }
    return out.sort((x, y) => x.orb - y.orb);
  }

  function fmtDeg(value) {
    const deg = Math.floor(value);
    const min = Math.floor((value - deg) * 60);
    return deg + "°" + pad(min) + "′";
  }
  function fmtPos(lon) {
    const s = Math.floor(lon / 30);
    return { text: fmtDeg(lon % 30), sign: SIGNS[s][0], glyph: SIGNS[s][1] };
  }

  // ---------- Lists ----------
  function drawLists(planets, aspects) {
    document.getElementById("planets").innerHTML = planets.map(p => {
      const pos = fmtPos(p.lon);
      return `<li>
        <span class="g glyph">${G(p.g)}</span>
        <span>${p.id}</span>
        <span class="pos">${pos.text} <span class="sign">${pos.sign}</span> <span class="glyph sign">${G(pos.glyph)}</span></span>
        <span class="retro">${p.retro ? "retrograde" : ""}</span>
      </li>`;
    }).join("");

    const el = document.getElementById("aspects");
    if (!aspects.length) {
      el.innerHTML = `<li class="empty">No major aspects within orb at this moment.</li>`;
      return;
    }
    el.innerHTML = aspects.map(({ a, b, asp, orb, applying }) => `<li>
      <span class="g glyph">${G(a.g)}</span>
      <span class="asp-name"><span style="color:${asp.color}"><span class="glyph">${G(asp.g)}</span> ${asp.name}</span><small>${a.id} and ${b.id}</small></span>
      <span class="g glyph">${G(b.g)}</span>
      <span class="orb">${fmtDeg(orb)}<br><span class="${applying ? "applying" : ""}">${applying ? "applying" : "separating"}</span></span>
    </li>`).join("");
  }

  // ---------- Stars ----------
  function drawStars() {
    const c = document.getElementById("stars");
    const dpr = window.devicePixelRatio || 1;
    c.width = innerWidth * dpr; c.height = innerHeight * dpr;
    const ctx = c.getContext("2d");
    ctx.scale(dpr, dpr);
    ctx.clearRect(0, 0, innerWidth, innerHeight);
    let seed = 7;
    const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
    const n = Math.floor(innerWidth * innerHeight / 5500);
    for (let i = 0; i < n; i++) {
      const x = rnd() * innerWidth, y = rnd() * innerHeight;
      const r = rnd() < 0.08 ? 1.5 : rnd() * 0.9 + 0.2;
      ctx.globalAlpha = 0.25 + rnd() * 0.6;
      ctx.fillStyle = rnd() < 0.2 ? "#e8c97a" : "#ece8f8";
      ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
    }
  }

  // ---------- State ----------
  let live = true;
  let current = new Date();
  const input = document.getElementById("when-input");
  const badge = document.getElementById("live-badge");

  const toLocalInput = d =>
    `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;

  function render() {
    if (typeof Astronomy === "undefined") {
      document.getElementById("error").style.display = "block";
      return;
    }
    const planets = computePlanets(current);
    const aspects = computeAspects(planets, current);
    drawLists(planets, aspects);
    document.getElementById("when").textContent = current.toLocaleString(undefined, {
      weekday: "long", year: "numeric", month: "long", day: "numeric",
      hour: "numeric", minute: "2-digit", timeZoneName: "short"
    });
    input.value = toLocalInput(current);
    badge.textContent = live ? "Live, updates every minute" : "Paused on the time you picked";
    badge.classList.toggle("off", !live);
  }

  input.addEventListener("change", () => {
    const d = new Date(input.value);
    if (isNaN(d)) return;
    live = false; current = d; render();
  });
  document.getElementById("now-btn").addEventListener("click", () => {
    live = true; current = new Date(); render();
  });
  setInterval(() => { if (live) { current = new Date(); render(); } }, 60000);
  addEventListener("resize", drawStars);

  drawStars();
  render();
})();
</script>
</body>
</html>
